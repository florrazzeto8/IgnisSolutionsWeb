<!-- CTA -->
<section class="cta">
  <div class="cta-glow"></div>
  <h2 class="fu">¿Listo para construir<br><span style="color:var(--cyan)">algo grande?</span></h2>
  <p class="fu d1">Contanos tu idea. Te respondemos en menos de 24 horas con un plan de acción concreto.</p>
  <div class="cta-btns fu d2">
    <a href="#" class="btn-primary">Empezar mi proyecto →</a>
    <a href="#" class="btn-outline">Ver portfolio</a>
  </div>
</section>

<script>
// ── AUTO LOADER ──
const loaderBg      = document.getElementById('loader-bg');
const loaderContent = document.getElementById('loader-content');
const lNum          = document.getElementById('lNum');
const lFill         = document.getElementById('lFill');
const heEls         = Array.from(document.querySelectorAll('.he'));

let loaderDone = false;
document.body.style.overflow = 'hidden';

const totalTime = 2600;
const startTime = performance.now();

function loaderTick(now) {
  const t = Math.min((now - startTime) / totalTime, 1);
  const eased = 1 - Math.pow(1 - t, 2.5);
  const val = Math.round(eased * 100);
  lNum.textContent = val;
  lFill.style.width = val + '%';
  if (t < 1) { requestAnimationFrame(loaderTick); return; }
  finishLoader();
}
requestAnimationFrame(loaderTick);

function finishLoader() {
  if (loaderDone) return;
  loaderDone = true;
  // 1. Content fades & slides down
  loaderContent.classList.add('exit');
  // 2. Background curtain slides down immediately after content
  setTimeout(() => {
    loaderBg.classList.add('exit');
    document.body.style.overflow = '';
  }, 150);
  // 3. Hero elements appear staggered after curtain starts
  const delays = [200, 400, 600, 800, 1000];
  heEls.forEach((el, i) => setTimeout(() => el.classList.add('in'), 500 + (delays[i] || i * 150)));
}

// Touch
let tyStart = 0;
window.addEventListener('touchstart', e => { tyStart = e.touches[0].clientY; }, { passive: true });
window.addEventListener('touchmove', e => {
  if (loaderDone) return;
  e.preventDefault();
  setProgress(prog + (tyStart - e.touches[0].clientY) * 0.2);
  tyStart = e.touches[0].clientY;
}, { passive: false });

// ── CURSOR ──
const cur = document.getElementById('cur');
const ring = document.getElementById('ring');
let mx = 0, my = 0, rx = 0, ry = 0;
document.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; cur.style.cssText += `left:${mx}px;top:${my}px`; });
(function animRing() {
  rx += (mx - rx) * .14; ry += (my - ry) * .14;
  ring.style.cssText += `left:${rx}px;top:${ry}px`;
  requestAnimationFrame(animRing);
})();

// ── PROGRESS BAR ──
const pb = document.getElementById('progress-bar');
window.addEventListener('scroll', () => {
  const h = document.documentElement.scrollHeight - innerHeight;
  pb.style.width = (scrollY / h * 100) + '%';
});

// ── NAV ──
const nav = document.getElementById('nav');
let lastScrollY = 0;
window.addEventListener('scroll', () => {
  nav.classList.toggle('scrolled', scrollY > 60);
  nav.classList.toggle('hidden', scrollY > lastScrollY && scrollY > 100);
  lastScrollY = scrollY;
}, { passive: true });

// ── PARTICLES ──
const cvs = document.getElementById('particles');
const ctx = cvs.getContext('2d');
const resize = () => { cvs.width = innerWidth; cvs.height = innerHeight; };
resize(); window.addEventListener('resize', resize);

const PTS = [];
let pmx = 0, pmy = 0;
cvs.addEventListener('mousemove', e => { pmx = e.clientX; pmy = e.clientY; });

class P {
  constructor() { this.reset(); }
  reset() {
    this.x = Math.random() * cvs.width;
    this.y = Math.random() * cvs.height;
    this.vx = (Math.random() - .5) * .35;
    this.vy = (Math.random() - .5) * .35;
    this.r  = Math.random() * 1.8 + .4;
    this.a  = Math.random() * .45 + .1;
  }
  update() {
    this.x += this.vx; this.y += this.vy;
    const dx = this.x - pmx, dy = this.y - pmy;
    const d = Math.sqrt(dx*dx+dy*dy);
    if (d < 110) { this.x += dx/d * 1.8; this.y += dy/d * 1.8; }
    if (this.x < 0 || this.x > cvs.width)  this.vx *= -1;
    if (this.y < 0 || this.y > cvs.height) this.vy *= -1;
  }
  draw() {
    ctx.beginPath();
    ctx.arc(this.x, this.y, this.r, 0, Math.PI*2);
    ctx.fillStyle = `rgba(0,200,255,${this.a})`;
    ctx.fill();
  }
}

for (let i = 0; i < 75; i++) PTS.push(new P());

function drawLines() {
  for (let i = 0; i < PTS.length; i++)
    for (let j = i+1; j < PTS.length; j++) {
      const dx = PTS[i].x - PTS[j].x, dy = PTS[i].y - PTS[j].y;
      const d = Math.sqrt(dx*dx+dy*dy);
      if (d < 115) {
        ctx.beginPath();
        ctx.strokeStyle = `rgba(0,200,255,${.11*(1-d/115)})`;
        ctx.lineWidth = .5;
        ctx.moveTo(PTS[i].x, PTS[i].y);
        ctx.lineTo(PTS[j].x, PTS[j].y);
        ctx.stroke();
      }
    }
}

(function animP() {
  ctx.clearRect(0, 0, cvs.width, cvs.height);
  PTS.forEach(p => { p.update(); p.draw(); });
  drawLines();
  requestAnimationFrame(animP);
})();

// ── TYPEWRITER ──
const words = ['expertos.', 'nosotros.', 'IGNIS.'];
let wi = 0, ci = 0, del = false;
const tel = document.getElementById('typed');
function type() {
  const w = words[wi];
  if (del) {
    tel.textContent = w.slice(0, ci--);
    if (ci < 0) { del = false; wi = (wi+1) % words.length; setTimeout(type, 450); return; }
  } else {
    tel.textContent = w.slice(0, ci++);
    if (ci > w.length) { del = true; setTimeout(type, 2200); return; }
  }
  setTimeout(type, del ? 55 : 95);
}
setTimeout(type, 1200);

// ── COUNTER ──
function counter(el) {
  const t = +el.dataset.t, dur = 2000, s = performance.now();
  (function u(now) {
    const p = Math.min((now-s)/dur, 1);
    el.textContent = Math.floor((1 - Math.pow(1-p, 3)) * t);
    if (p < 1) requestAnimationFrame(u);
  })(s);
}

// ── INTERSECTION OBSERVER (bidireccional) ──
const io = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.target.classList.contains('fu')) {
      e.target.classList.toggle('vis', e.isIntersecting);
    }
    if (e.target.classList.contains('card')) {
      e.target.classList.toggle('visible', e.isIntersecting);
    }
    if (e.isIntersecting) {
      if (e.target.classList.contains('cnt'))  { counter(e.target); io.unobserve(e.target); }
      if (e.target.id === 'skills') {
        e.target.querySelectorAll('.fill').forEach((b,i) =>
          setTimeout(() => b.style.width = b.dataset.w+'%', i*100));
        io.unobserve(e.target);
      }
    }
  });
}, { threshold: 0.15 });

document.querySelectorAll('.fu, .card, .cnt, #skills').forEach(el => io.observe(el));

// ── 3D CARD TILT ──
document.querySelectorAll('[data-tilt]').forEach(card => {
  card.addEventListener('mousemove', e => {
    const r = card.getBoundingClientRect();
    const x = e.clientX - r.left, y = e.clientY - r.top;
    const rx2 = (y / r.height - .5) * -10;
    const ry2 = (x / r.width  - .5) *  10;
    card.style.transform = `perspective(900px) rotateX(${rx2}deg) rotateY(${ry2}deg) translateZ(8px) translateY(0)`;
    card.style.setProperty('--mx', (x/r.width*100)+'%');
    card.style.setProperty('--my', (y/r.height*100)+'%');
  });
  card.addEventListener('mouseleave', () => {
    card.style.transform = 'perspective(900px) rotateX(0) rotateY(0) translateZ(0) translateY(0)';
  });
});



// ── ABOUT CARD EXPAND ──
const aboutZone  = document.getElementById('aboutZone');
const aboutCard  = document.getElementById('aboutCard');
const aboutInner = document.getElementById('aboutInner');
const heroInner  = document.querySelector('.hero-inner');

function easeOut(t) { return 1 - Math.pow(1 - t, 2); }

let rafPending = false;
function scheduleAbout() {
  if (!rafPending) { rafPending = true; requestAnimationFrame(() => { rafPending = false; updateAbout(); }); }
}

function updateAbout() {
  if (!aboutZone || !aboutCard) return;
  const rect  = aboutZone.getBoundingClientRect();
  const total = aboutZone.offsetHeight - window.innerHeight;
  const p     = Math.max(0, Math.min(1, -rect.top / total));
  const e     = easeOut(p);

  // Width: 44vw → 100vw
  const w = 44 + 56 * e;
  // Height: 40px → 100vh
  const h = 40 + (window.innerHeight - 40) * e;
  // Border radius
  const br = Math.round(16 * (1 - e));
  // Box shadow grows with card
  const shadowAlpha = e * 0.5;

  aboutCard.style.width        = w + 'vw';
  aboutCard.style.height       = h + 'px';
  aboutCard.style.borderRadius = br + 'px 0 0 ' + br + 'px';
  aboutCard.style.boxShadow    = `-8px -8px 40px rgba(0,0,0,${shadowAlpha})`;

  // Hero content scrolls up & fades naturally
  if (heroInner) heroInner.style.opacity = Math.max(0, 1 - p * 3);
}

window.addEventListener('scroll', scheduleAbout, { passive: true });
updateAbout();

// ── PROCESS STEP HIGHLIGHT ──
const stepsIO = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
      e.target.classList.add('active');
    }
  });
}, { threshold: .65 });
document.querySelectorAll('.step').forEach(s => stepsIO.observe(s));
</script>
</body>